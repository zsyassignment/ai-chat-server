# Public C++ gateway
AGENT_SERVICE_URL=http://127.0.0.1:8010

# Optional native C++ direct-chat endpoint: POST /api/chat/direct
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com/v1/chat/completions
OPENAI_MODEL=deepseek-chat

# Embedded LangGraph Agent
APP_HOST=127.0.0.1
APP_PORT=8010
DATA_DIR=./data/learningflow
DATABASE_PATH=./data/learningflow/learningflow.db
CHECKPOINT_PATH=./data/learningflow/checkpoints.db
SKILLS_DIR=./data/learningflow/skills

LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1/chat/completions
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=90

# Local and free by default. The first run downloads the ONNX model.
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_NAMESPACE=fastembed:BAAI/bge-small-zh-v1.5
EMBEDDING_CACHE_DIR=./data/learningflow/models

QDRANT_MODE=local
QDRANT_PATH=./data/learningflow/qdrant
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=learningflow_chunks
QDRANT_SCORE_THRESHOLD=0.25
CHUNK_SIZE=800
CHUNK_OVERLAP=120
VECTOR_RECALL_K=10
KEYWORD_RECALL_K=10
RRF_K=60
RRF_VECTOR_WEIGHT=0.1
RRF_KEYWORD_WEIGHT=1.0

RERANKER_ENABLED=false
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_TOP_N=5

# Optional web-search tool
TAVILY_API_KEY=
WEB_SEARCH_MAX_RESULTS=5
RESEARCH_MAX_ITERATIONS=6
RESEARCH_MAX_TOOL_CALLS=10
CONVERSATION_RECENT_MESSAGES=10
CONVERSATION_TOKEN_BUDGET=6000
CONVERSATION_SUMMARY_TRIGGER_TOKENS=4000
MAX_REWRITE_COUNT=1
MAX_RETRIEVAL_RESULTS=5
REQUIRE_PLAN_APPROVAL=true
