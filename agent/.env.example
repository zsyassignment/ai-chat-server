APP_HOST=127.0.0.1
APP_PORT=8010
DATA_DIR=./data
DATABASE_PATH=./data/learningflow.db
CHECKPOINT_PATH=./data/checkpoints.db
SKILLS_DIR=./data/skills

LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1/chat/completions
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=90

# fastembed is local, free, CPU-friendly, and the default provider.
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_NAMESPACE=fastembed:BAAI/bge-small-zh-v1.5
EMBEDDING_CACHE_DIR=./data/models

# Only required when EMBEDDING_PROVIDER=openai.
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1/embeddings
EMBEDDING_TIMEOUT=30

QDRANT_MODE=local
QDRANT_PATH=./data/qdrant
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=learningflow_chunks
QDRANT_SCORE_THRESHOLD=0.25
CHUNK_SIZE=800
CHUNK_OVERLAP=120
VECTOR_RECALL_K=10
KEYWORD_RECALL_K=10
RRF_K=60
# Tuned on the 20-case mixed-corpus dev split; keep the 80-case test split held out.
RRF_VECTOR_WEIGHT=0.03
RRF_KEYWORD_WEIGHT=1.0
# Optional diversity control. 0 keeps all ranked chunks; 1 keeps one chunk per document.
MAX_CHUNKS_PER_DOCUMENT=0

# Optional open-source cross-encoder reranker. Enabling downloads/loads the model.
RERANKER_ENABLED=false
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_TOP_N=5

# Hosted web search API used by the Agent. Leave blank to disable web search.
TAVILY_API_KEY=
WEB_SEARCH_MAX_RESULTS=5
RESEARCH_MAX_ITERATIONS=6
RESEARCH_MAX_TOOL_CALLS=10
CONVERSATION_RECENT_MESSAGES=10
CONVERSATION_TOKEN_BUDGET=6000
CONVERSATION_SUMMARY_TRIGGER_TOKENS=4000

MAX_REWRITE_COUNT=1
MAX_RETRIEVAL_RESULTS=5
REQUIRE_PLAN_APPROVAL=true
